<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:u="UnityEditor.UIElements">
  <Style src="Map.uss" />
  <ui:VisualElement name="root" class="root">
    <ui:Label name="hud" class="hud" text="ДЕНЬ 1 · УТРО" />

    <ui:VisualElement name="map" class="map" />

    <ui:VisualElement name="left-panel" class="panel left">
      <ui:Label text="ОТРЯДЫ" class="panel-title" />
      <ui:VisualElement name="squads" class="squads" />
    </ui:VisualElement>

    <ui:VisualElement name="bottom-bar" class="bottom">
      <ui:Label name="warnings" text="" class="warnings" />
      <ui:Button name="sign-button" text="НАЧАТЬ ДЕНЬ" class="action primary" />
    </ui:VisualElement>

    <ui:VisualElement name="pane" class="pane hidden">
      <ui:Label name="pane-title" text="" class="panel-title" />
      <ui:ScrollView name="pane-lines" class="pane-lines" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      <ui:Button name="pane-button" text="ДАЛЬШЕ" class="action primary pane-button" />
    </ui:VisualElement>

    <ui:VisualElement name="expedition" class="expedition hidden">
      <ui:VisualElement class="expedition-head">
        <ui:Label name="expedition-title" text="ПОХОД" class="panel-title" />
        <ui:Label name="expedition-hour" text="" class="zone-meta" />
      </ui:VisualElement>
      <ui:ScrollView name="expedition-log" class="expedition-log" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      <ui:VisualElement name="expedition-card" class="decision-card hidden">
        <ui:Label name="decision-title" text="" class="decision-title" />
        <ui:Label name="decision-body" text="" class="zone-text" />
        <ui:VisualElement name="decision-options" class="decision-options" />
      </ui:VisualElement>
      <ui:VisualElement class="modal-buttons">
        <ui:Button name="expedition-skip" text="ДОМОТАТЬ" class="action" />
        <ui:Button name="expedition-pause" text="ПАУЗА" class="action primary" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="village" class="village hidden">
      <ui:Label name="village-title" text="ДЕРЕВНЯ" class="panel-title" />
      <ui:Label name="village-palisade" text="" class="zone-text" />
      <ui:Label text="РАБОТЫ" class="panel-subtitle" />
      <ui:VisualElement name="village-works" class="works" />
      <ui:Label text="КТО ГДЕ" class="panel-subtitle" />
      <ui:ScrollView name="village-people" class="village-people" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      <ui:Button name="village-close" text="ГОТОВО ↩" class="action primary pane-button" />
    </ui:VisualElement>

    <ui:VisualElement name="startday" class="startday hidden">
      <ui:Label name="startday-title" text="ДЕНЬ 1" class="startday-title" />
      <ui:ScrollView name="startday-lines" class="startday-lines" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      <ui:Button name="startday-go" text="НАЧАТЬ ДЕНЬ →" class="action primary pane-button" />
    </ui:VisualElement>

    <ui:VisualElement name="evening" class="evening hidden">
      <ui:Label name="evening-title" text="ВЕЧЕР" class="panel-title" />
      <ui:VisualElement class="evening-columns">
        <ui:ScrollView name="evening-lines" class="evening-lines" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
        <ui:VisualElement class="evening-beds">
          <ui:Label text="ПОСТЕЛИ" class="panel-subtitle" />
          <ui:ScrollView name="evening-wounded" class="evening-wounded" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:Button name="evening-sleep" text="СПАТЬ →" class="action primary pane-button" />
    </ui:VisualElement>

    <ui:VisualElement name="dossier" class="dossier hidden">
      <ui:VisualElement class="dossier-body">
        <ui:VisualElement name="dossier-art" class="dossier-art" />
        <ui:ScrollView name="dossier-text" class="dossier-text" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      </ui:VisualElement>
      <ui:VisualElement class="modal-buttons">
        <ui:Button name="dossier-back" text="← НАЗАД" class="action" />
        <ui:Button name="dossier-gather" text="К СБОРКЕ ЭТОЙ ЗОНЫ" class="action primary" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="muster" class="muster hidden">
      <ui:Label name="muster-title" text="СБОР ОТРЯДА" class="panel-title" />
      <ui:VisualElement name="muster-squads" class="muster-squads" />
      <ui:VisualElement class="muster-columns">
        <ui:VisualElement class="muster-column">
          <ui:Label text="СВОБОДНЫЕ ЛЮДИ" class="panel-subtitle" />
          <ui:ScrollView name="muster-free" class="muster-free" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
        </ui:VisualElement>
        <ui:VisualElement class="muster-column wide">
          <ui:Label text="СОСТАВ ОТРЯДА" class="panel-subtitle" />
          <ui:VisualElement name="muster-tray" class="muster-tray" />
          <ui:Label name="muster-summary" text="" class="squad-line" />
          <ui:Label text="НАКАЗЫ НА ВЫЛАЗКУ" class="panel-subtitle" />
          <ui:VisualElement name="muster-orders" class="muster-orders" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="modal-buttons">
        <ui:Button name="muster-done" text="ГОТОВО" class="action primary" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="modal" class="modal hidden">
      <ui:Label name="modal-title" text="ПРИКАЗ НА ВЫЛАЗКУ" class="panel-title" />
      <ui:ScrollView name="modal-lines" class="pane-lines" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
      <ui:VisualElement class="modal-buttons">
        <ui:Button name="modal-cancel" text="НЕ ПОКА, ДОПОЛНЮ" class="action" />
        <ui:Button name="modal-confirm" text="НАЧАТЬ ДЕНЬ" class="action primary" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="menu" class="menu">
      <ui:Label text="ЛЕСНАЯ ГИЛЬДИЯ" class="menu-title" />
      <ui:Label text="деревня на краю магического леса" class="menu-subtitle" />
      <ui:VisualElement class="menu-buttons">
        <ui:Button name="menu-play" text="НАЧАТЬ ИГРУ" class="action primary menu-button" />
        <ui:Button name="menu-sim" text="СБОР ОТРЯДА (ТЕСТИРОВАНИЕ)" class="action menu-button" />
      </ui:VisualElement>
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>

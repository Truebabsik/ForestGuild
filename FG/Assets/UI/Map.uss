.root {
    flex-grow: 1;
    background-color: rgb(20, 22, 20);
}

.map {
    position: absolute;
    left: 250px;
    right: 330px;
    top: 0;
    bottom: 96px;
    background-image: url("project://database/Assets/UI/Art/map_bg.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.panel {
    position: absolute;
    top: 0;
    bottom: 96px;
    padding: 14px;
    background-color: rgb(34, 36, 32);
    border-color: rgb(150, 128, 88);
    border-width: 2px;
    border-left-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.panel.left {
    left: 0;
    width: 250px;
}

.panel.right {
    right: 0;
    width: 420px;
    border-left-width: 2px;
    border-right-width: 0;
}

.zone-card {
    flex-grow: 1;
}

.zone-art {
    height: 186px;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: rgb(120, 104, 74);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 22, 20);
}

.zone-art-verge_meadow { background-image: url("project://database/Assets/UI/Art/Zones/verge_meadow.jpg"); }
.zone-art-verge_springs { background-image: url("project://database/Assets/UI/Art/Zones/verge_springs.jpg"); }
.zone-art-verge_marsh { background-image: url("project://database/Assets/UI/Art/Zones/verge_marsh.jpg"); }
.zone-art-verge_thicket { background-image: url("project://database/Assets/UI/Art/Zones/verge_thicket.jpg"); }
.zone-art-belt_stone { background-image: url("project://database/Assets/UI/Art/Zones/belt_stone.jpg"); }
.zone-art-heart_root { background-image: url("project://database/Assets/UI/Art/Zones/heart_root.jpg"); }

.zone-title {
    color: rgb(232, 214, 176);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.zone-meta {
    color: rgb(168, 154, 124);
    font-size: 12px;
    margin-bottom: 10px;
    white-space: normal;
}

.zone-text {
    color: rgb(206, 202, 190);
    font-size: 13px;
    margin-bottom: 10px;
    white-space: normal;
}

.zone-section-title {
    color: rgb(160, 146, 118);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 2px;
}

.debug-toggle {
    color: rgb(168, 154, 124);
    font-size: 12px;
    margin-right: 12px;
}

.panel-title {
    color: rgb(226, 208, 170);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
}

.panel-subtitle {
    color: rgb(160, 146, 118);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 4px;
}

.behavior-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.behavior {
    flex-grow: 1;
    height: 26px;
    font-size: 10px;
    margin-right: 3px;
    padding: 0;
    color: rgb(206, 198, 178);
    background-color: rgb(44, 46, 40);
    border-width: 1px;
    border-color: rgb(90, 84, 70);
}

.behavior.selected {
    background-color: rgb(96, 78, 42);
    border-color: rgb(226, 190, 110);
    color: rgb(245, 232, 200);
}

.button-row {
    flex-direction: row;
}

.button-row .action {
    flex-grow: 1;
    margin-right: 4px;
    height: 34px;
    font-size: 12px;
}

.parties {
    max-height: 176px;
}

.party-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.party-row .party-text {
    flex-grow: 1;
    color: rgb(206, 198, 178);
    font-size: 11px;
    white-space: normal;
}

.party-row .party-remove {
    width: 22px;
    height: 22px;
    font-size: 11px;
    padding: 0;
    color: rgb(226, 170, 140);
    background-color: rgb(58, 40, 34);
    border-width: 1px;
    border-color: rgb(150, 90, 70);
}

.zone-info {
    color: rgb(196, 196, 184);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 6px;
}

.roster {
    flex-grow: 1;
    max-height: 264px;
    margin-bottom: 8px;
}

.roster .unity-button {
    height: 28px;
    margin-bottom: 3px;
    font-size: 11px;
    background-color: rgb(48, 50, 44);
    color: rgb(214, 208, 190);
    border-width: 1px;
    border-color: rgb(90, 84, 70);
    -unity-text-align: middle-left;
    padding-left: 8px;
    white-space: nowrap;
}

.roster .unity-button.selected {
    background-color: rgb(92, 74, 40);
    border-color: rgb(226, 190, 110);
    color: rgb(245, 232, 200);
}

.roster .unity-button.busy {
    opacity: 0.45;
    color: rgb(160, 154, 138);
}

.village-node {
    position: absolute;
    width: 130px;
    height: 152px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
    align-items: center;
    padding: 0;
}

.village-icon {
    width: 96px;
    height: 96px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(196, 150, 90);
    background-image: url("project://database/Assets/UI/Art/Icons/village.png");
    -unity-background-scale-mode: scale-and-crop;
}

.village-node.selected .village-icon {
    border-color: rgb(240, 190, 90);
    border-width: 4px;
}

.village-node .village-name {
    margin-top: 3px;
    color: rgb(238, 220, 184);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.village-node .village-state {
    color: rgb(200, 170, 130);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(34, 36, 32);
    border-top-width: 2px;
    border-color: rgb(150, 128, 88);
}

.day-label {
    color: rgb(226, 208, 170);
    font-size: 22px;
    -unity-font-style: bold;
}

.action {
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 14px;
    color: rgb(240, 230, 205);
    background-color: rgb(62, 64, 54);
    border-width: 2px;
    border-color: rgb(150, 128, 88);
}

.action.primary {
    background-color: rgb(150, 96, 40);
    border-color: rgb(226, 190, 110);
}

.zone-node {
    position: absolute;
    width: 120px;
    height: 152px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
    align-items: center;
    padding: 0;
}

.zone-icon {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 3px;
    border-color: rgb(150, 128, 88);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(24, 26, 22);
}

.zone-node.selected .zone-icon {
    border-color: rgb(240, 190, 90);
    border-width: 4px;
}

.zone-node.danger .zone-icon {
    border-color: rgb(178, 96, 60);
}

.icon-verge_meadow { background-image: url("project://database/Assets/UI/Art/Icons/zone_meadow.png"); }
.icon-verge_springs { background-image: url("project://database/Assets/UI/Art/Icons/zone_springs.png"); }
.icon-verge_marsh { background-image: url("project://database/Assets/UI/Art/Icons/zone_marsh.png"); }
.icon-verge_thicket { background-image: url("project://database/Assets/UI/Art/Icons/zone_thicket.png"); }
.icon-belt_stone { background-image: url("project://database/Assets/UI/Art/Icons/zone_stone.png"); }
.icon-heart_root { background-image: url("project://database/Assets/UI/Art/Icons/zone_heart.png"); }

.zone-node-name {
    margin-top: 3px;
    color: rgb(228, 214, 180);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.zone-node-state {
    color: rgb(180, 150, 110);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.report {
    position: absolute;
    left: 270px;
    right: 440px;
    top: 20px;
    bottom: 140px;
    background-color: rgb(16, 18, 16);
    border-width: 2px;
    border-color: rgb(150, 128, 88);
    padding: 16px;
}

.report-close {
    width: 170px;
    align-self: flex-start;
}

.report-lines {
    flex-grow: 1;
    margin-bottom: 10px;
}

.report-lines .unity-label {
    color: rgb(206, 206, 192);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 3px;
}

.toast {
    position: absolute;
    left: 250px;
    right: 440px;
    bottom: 106px;
    padding: 8px 12px;
    background-color: rgb(46, 42, 32);
    border-width: 2px;
    border-color: rgb(196, 150, 90);
    color: rgb(240, 226, 194);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hidden {
    display: none;
}

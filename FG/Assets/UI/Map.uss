/* ForestGuild — UI (UI Toolkit). Только используемые классы. */

.root {
    flex-grow: 1;
    background-color: rgb(20, 22, 20);
}

.hidden {
    display: none;
}

/* ---- HUD ---- */

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 36px;
    padding: 8px 20px 0 20px;
    background-color: rgb(30, 32, 28);
    border-bottom-width: 2px;
    border-color: rgb(120, 104, 74);
    color: rgb(226, 208, 170);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ---- карта ---- */

.map {
    position: absolute;
    left: 520px;
    right: 0;
    top: 36px;
    bottom: 96px;
    background-image: url("project://database/Assets/UI/Art/map_bg.jpg");
    -unity-background-scale-mode: scale-and-crop;
}

.zone-node {
    position: absolute;
    width: 120px;
    height: 152px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
    align-items: center;
    padding: 0;
}

.zone-icon {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 3px;
    border-color: rgb(150, 128, 88);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(24, 26, 22);
}

.zone-node.selected .zone-icon {
    border-color: rgb(240, 190, 90);
    border-width: 4px;
}

.zone-node.danger .zone-icon {
    border-color: rgb(178, 96, 60);
}

.icon-verge_meadow { background-image: url("project://database/Assets/UI/Art/Icons/zone_meadow.png"); }
.icon-verge_springs { background-image: url("project://database/Assets/UI/Art/Icons/zone_springs.png"); }
.icon-verge_marsh { background-image: url("project://database/Assets/UI/Art/Icons/zone_marsh.png"); }
.icon-verge_thicket { background-image: url("project://database/Assets/UI/Art/Icons/zone_thicket.png"); }
.icon-belt_stone { background-image: url("project://database/Assets/UI/Art/Icons/zone_stone.png"); }
.icon-heart_root { background-image: url("project://database/Assets/UI/Art/Icons/zone_heart.png"); }

.zone-node-name {
    margin-top: 3px;
    color: rgb(228, 214, 180);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.zone-node-state {
    color: rgb(180, 150, 110);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.village-node {
    position: absolute;
    width: 130px;
    height: 152px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-start;
    align-items: center;
    padding: 0;
}

.village-icon {
    width: 96px;
    height: 96px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(196, 150, 90);
    background-image: url("project://database/Assets/UI/Art/Icons/village.png");
    -unity-background-scale-mode: scale-and-crop;
}

.village-node.selected .village-icon {
    border-color: rgb(240, 190, 90);
    border-width: 4px;
}

.village-node .village-name {
    margin-top: 3px;
    color: rgb(238, 220, 184);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.village-node .village-state {
    color: rgb(200, 170, 130);
    font-size: 10px;
    -unity-text-align: middle-center;
}

/* ---- панели ---- */

.panel {
    position: absolute;
    top: 36px;
    bottom: 96px;
    padding: 14px;
    background-color: rgb(34, 36, 32);
    border-color: rgb(150, 128, 88);
    border-width: 2px;
    border-left-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.panel.left {
    left: 0;
    width: 520px;
}

.panel-title {
    color: rgb(226, 208, 170);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    white-space: normal;
}

.panel-subtitle {
    color: rgb(160, 146, 118);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 4px;
}

/* ---- отряды на планировании ---- */

.squads {
    flex-direction: column;
    margin-bottom: 6px;
}

.squad-card {
    border-width: 1px;
    border-color: rgb(96, 88, 70);
    background-color: rgb(42, 44, 38);
    padding: 8px;
    margin-bottom: 6px;
}

.squad-card.active {
    border-color: rgb(226, 190, 110);
    border-width: 2px;
    background-color: rgb(52, 48, 38);
}

.squad-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.squad-name {
    color: rgb(232, 214, 176);
    font-size: 14px;
    -unity-font-style: bold;
}

.squad-members {
    color: rgb(200, 196, 180);
    font-size: 12px;
    margin-top: 3px;
    white-space: normal;
}

.squad-line {
    color: rgb(168, 160, 140);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

.squad-body {
    flex-direction: row;
    margin-top: 4px;
}

.squad-left {
    flex-grow: 1;
}

.squad-portraits {
    flex-direction: row;
    align-items: flex-start;
}

.squad-portraits .portrait {
    width: 46px;
    height: 46px;
    margin-left: 4px;
    border-color: rgb(120, 104, 74);
}

.squad-actions {
    flex-direction: row;
    margin-top: 5px;
}

.squad-actions .action {
    height: 26px;
    font-size: 11px;
    margin-right: 4px;
    padding: 0 8px;
}

.menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 14, 12);
}

/* ---- кит из ext: золотая плашка под заголовки ---- */

.kit-title {
    width: 560px;
    height: 104px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/UI/Art/Kit/plate.png");
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    -unity-background-scale-mode: stretch-to-fill;
    margin-bottom: 8px;
}

.menu-title {
    color: rgb(52, 36, 20);
    font-size: 40px;
    -unity-font-style: bold;
    margin: 0;
}

.menu-subtitle {
    color: rgb(168, 152, 120);
    font-size: 15px;
    margin-bottom: 40px;
}

.menu-buttons {
    flex-direction: column;
    align-items: center;
}

.menu-button {
    width: 380px;
    height: 52px;
    margin-bottom: 12px;
    font-size: 15px;
}

.action {
    height: 40px;
    padding: 0 16px;
    font-size: 14px;
    color: rgb(240, 224, 190);
    background-color: rgb(19, 82, 94);
    border-width: 2px;
    border-color: rgb(201, 154, 90);
    border-top-color: rgb(232, 194, 126);
    border-bottom-color: rgb(110, 78, 42);
}

.action:hover {
    background-color: rgb(27, 106, 118);
    border-color: rgb(232, 194, 126);
}

.action.primary {
    background-color: rgb(26, 138, 124);
    border-color: rgb(240, 204, 126);
}

.action.primary:hover {
    background-color: rgb(34, 160, 144);
}

.action.selected {
    background-color: rgb(52, 96, 84);
    border-color: rgb(240, 204, 126);
}

/* ---- портреты и карточки людей ---- */

.portrait {
    width: 64px;
    height: 64px;
    border-width: 2px;
    border-color: rgb(88, 82, 68);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(24, 26, 22);
}

.portrait-small {
    width: 40px;
    height: 40px;
}

.portrait-brunni { background-image: url("project://database/Assets/UI/Art/Portraits/brunni.jpg"); }
.portrait-skadi { background-image: url("project://database/Assets/UI/Art/Portraits/skadi.jpg"); }
.portrait-hilda { background-image: url("project://database/Assets/UI/Art/Portraits/hilda.jpg"); }
.portrait-orn { background-image: url("project://database/Assets/UI/Art/Portraits/orn.jpg"); }
.portrait-leya { background-image: url("project://database/Assets/UI/Art/Portraits/leya.jpg"); }
.portrait-tove { background-image: url("project://database/Assets/UI/Art/Portraits/tove.jpg"); }
.portrait-run { background-image: url("project://database/Assets/UI/Art/Portraits/run.jpg"); }
.portrait-valda { background-image: url("project://database/Assets/UI/Art/Portraits/valda.jpg"); }

.person-info {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 6px;
}

.person-name {
    color: rgb(226, 214, 190);
    font-size: 12px;
    white-space: normal;
}

.person-note {
    color: rgb(168, 154, 124);
    font-size: 10px;
    white-space: normal;
}

/* ---- работы в деревне ---- */

.works {
    margin-bottom: 6px;
}

.work-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.work-label {
    color: rgb(206, 202, 190);
    font-size: 12px;
    width: 150px;
}

.work-count {
    color: rgb(226, 208, 170);
    font-size: 12px;
    width: 26px;
    -unity-text-align: middle-center;
}

.work-button {
    width: 24px;
    height: 22px;
    font-size: 12px;
    padding: 0;
    margin-left: 3px;
    color: rgb(226, 208, 170);
    background-color: rgb(56, 58, 50);
    border-width: 1px;
    border-color: rgb(96, 88, 70);
}

.warnings {
    color: rgb(226, 170, 120);
    font-size: 12px;
    flex-grow: 1;
    white-space: normal;
}

/* ---- нижняя панель ---- */

.bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    background-color: rgb(34, 36, 32);
    border-top-width: 2px;
    border-color: rgb(150, 128, 88);
}

/* ---- экраны фаз ---- */

.pane,
.evening,
.dossier,
.muster,
.village,
.startday {
    position: absolute;
    background-color: rgb(16, 18, 16);
    border-width: 2px;
    border-color: rgb(150, 128, 88);
    padding: 20px;
}

.pane,
.evening,
.dossier,
.muster,
.startday {
    left: 60px;
    right: 60px;
    top: 56px;
    bottom: 40px;
}

.dossier,
.muster {
    padding: 28px;
}

.pane-lines {
    flex-grow: 1;
    margin-bottom: 12px;
}

.pane-lines .unity-label,
.pane-line {
    color: rgb(208, 204, 190);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 4px;
}

.pane-line.link {
    color: rgb(232, 198, 132);
}

.wave-title {
    color: rgb(228, 96, 70);
    font-size: 16px;
    -unity-font-style: bold;
    margin: 12px 0 4px 0;
}

.wave-line {
    color: rgb(238, 150, 120);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 4px;
}

.pane-button {
    width: 260px;
    align-self: flex-end;
}

/* ---- окно начала дня ---- */

.startday {
    left: 300px;
    right: 300px;
    top: 90px;
    bottom: 120px;
    border-color: rgb(196, 150, 90);
    padding: 24px;
}

.startday-title {
    color: rgb(238, 220, 180);
    font-size: 34px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.startday-lines {
    flex-grow: 1;
}

.startday-lines .unity-label {
    color: rgb(216, 210, 194);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 5px;
}

/* ---- деревня ---- */

.expedition {
    position: absolute;
    left: 60px;
    right: 60px;
    top: 56px;
    bottom: 40px;
    background-color: rgb(16, 18, 16);
    border-width: 2px;
    border-color: rgb(150, 128, 88);
    padding: 20px;
}

.expedition-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.expedition-log {
    flex-grow: 1;
    margin: 10px 0;
    border-width: 1px;
    border-color: rgb(70, 66, 56);
    padding: 8px;
}

.expedition-log .unity-label {
    color: rgb(208, 204, 190);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 3px;
}

.decision-card {
    border-width: 2px;
    border-color: rgb(226, 190, 110);
    background-color: rgb(28, 26, 20);
    padding: 14px;
    margin-bottom: 10px;
}

.decision-title {
    color: rgb(240, 214, 160);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.decision-options {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.decision-option {
    flex-grow: 1;
    min-width: 200px;
    height: 32px;
    font-size: 12px;
    margin: 0 6px 6px 0;
    padding: 0 8px;
    color: rgb(232, 222, 196);
    background-color: rgb(62, 54, 36);
    border-width: 1px;
    border-color: rgb(196, 150, 90);
    white-space: normal;
}

.monster-modal {
    position: absolute;
    left: 300px;
    right: 300px;
    top: 64px;
    background-color: rgb(16, 18, 16);
    border-width: 2px;
    border-color: rgb(228, 96, 70);
    padding: 14px;
}

.monster-art {
    height: 300px;
    border-width: 1px;
    border-color: rgb(120, 84, 60);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(24, 22, 20);
}

.monster-title {
    color: rgb(240, 214, 160);
    font-size: 24px;
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

.monster-art-spark-search { background-image: url("project://database/Assets/UI/Art/Monsters/spark_search.jpg"); }
.monster-art-bone-search { background-image: url("project://database/Assets/UI/Art/Monsters/bone_search.jpg"); }
.monster-art-ash-search { background-image: url("project://database/Assets/UI/Art/Monsters/ash_search.jpg"); }
.monster-art-spark-dead { background-image: url("project://database/Assets/UI/Art/Monsters/spark_dead.jpg"); }
.monster-art-bone-dead { background-image: url("project://database/Assets/UI/Art/Monsters/bone_dead.jpg"); }
.monster-art-ash-dead { background-image: url("project://database/Assets/UI/Art/Monsters/ash_dead.jpg"); }
.monster-art-spark-attack { background-image: url("project://database/Assets/UI/Art/Monsters/spark_attack.jpg"); }
.monster-art-bone-attack { background-image: url("project://database/Assets/UI/Art/Monsters/bone_attack.jpg"); }
.monster-art-ash-attack { background-image: url("project://database/Assets/UI/Art/Monsters/ash_attack.jpg"); }
.monster-art-angler-search { background-image: url("project://database/Assets/UI/Art/Monsters/angler_search.jpg"); }
.monster-art-angler-attack { background-image: url("project://database/Assets/UI/Art/Monsters/angler_attack.jpg"); }
.monster-art-angler-dead { background-image: url("project://database/Assets/UI/Art/Monsters/angler_dead.jpg"); }
.monster-art-climber-search { background-image: url("project://database/Assets/UI/Art/Monsters/climber_search.jpg"); }
.monster-art-climber-attack { background-image: url("project://database/Assets/UI/Art/Monsters/climber_attack.jpg"); }
.monster-art-climber-dead { background-image: url("project://database/Assets/UI/Art/Monsters/climber_dead.jpg"); }
.monster-art-fang-search { background-image: url("project://database/Assets/UI/Art/Monsters/fang_search.jpg"); }
.monster-art-fang-attack { background-image: url("project://database/Assets/UI/Art/Monsters/fang_attack.jpg"); }
.monster-art-fang-dead { background-image: url("project://database/Assets/UI/Art/Monsters/fang_dead.jpg"); }
.monster-art-mole-search { background-image: url("project://database/Assets/UI/Art/Monsters/mole_search.jpg"); }

.village {
    left: 180px;
    right: 180px;
    top: 70px;
    bottom: 80px;
    border-color: rgb(196, 150, 90);
    padding: 22px;
}

.village-people {
    flex-grow: 1;
    margin-bottom: 10px;
}

.village-people .unity-label {
    color: rgb(206, 202, 190);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 3px;
}

/* ---- вечер ---- */

.evening-columns {
    flex-direction: row;
    flex-grow: 1;
}

.evening-lines {
    flex-grow: 1;
    margin-right: 18px;
}

.evening-lines .unity-label {
    color: rgb(220, 216, 204);
    font-size: 15px;
    white-space: normal;
    margin-bottom: 6px;
}

.evening-beds {
    width: 440px;
    border-width: 1px;
    border-color: rgb(96, 88, 70);
    padding: 10px;
}

.evening-wounded {
    flex-grow: 1;
}

.bed-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-width: 1px;
    border-color: rgb(150, 110, 70);
    background-color: rgb(46, 40, 32);
    padding: 6px 8px;
    margin-bottom: 6px;
}

.bed-row.taken {
    border-color: rgb(120, 160, 110);
    background-color: rgb(38, 46, 36);
}

.bed-name {
    color: rgb(226, 214, 190);
    font-size: 13px;
}

.bed-note {
    color: rgb(176, 166, 142);
    font-size: 11px;
}

.bed-button {
    height: 26px;
    font-size: 11px;
    padding: 0 10px;
    color: rgb(230, 220, 196);
    background-color: rgb(62, 64, 54);
    border-width: 1px;
    border-color: rgb(120, 104, 74);
}

/* ---- досье зоны ---- */

.dossier-body {
    flex-direction: row;
    flex-grow: 1;
}

.dossier-art {
    width: 46%;
    height: 100%;
    margin-right: 20px;
    border-width: 2px;
    border-color: rgb(120, 104, 74);
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgb(20, 22, 20);
}

.zone-art-verge_meadow { background-image: url("project://database/Assets/UI/Art/Zones/verge_meadow.jpg"); }
.zone-art-verge_springs { background-image: url("project://database/Assets/UI/Art/Zones/verge_springs.jpg"); }
.zone-art-verge_marsh { background-image: url("project://database/Assets/UI/Art/Zones/verge_marsh.jpg"); }
.zone-art-verge_thicket { background-image: url("project://database/Assets/UI/Art/Zones/verge_thicket.jpg"); }
.zone-art-belt_stone { background-image: url("project://database/Assets/UI/Art/Zones/belt_stone.jpg"); }
.zone-art-heart_root { background-image: url("project://database/Assets/UI/Art/Zones/heart_root.jpg"); }

.dossier-text {
    flex-grow: 1;
}

.zone-title {
    color: rgb(232, 214, 176);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.zone-meta {
    color: rgb(168, 154, 124);
    font-size: 12px;
    margin-bottom: 10px;
    white-space: normal;
}

.zone-text {
    color: rgb(206, 202, 190);
    font-size: 13px;
    margin-bottom: 10px;
    white-space: normal;
}

.zone-section-title {
    color: rgb(160, 146, 118);
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 2px;
}

.dossier .zone-title {
    font-size: 28px;
}

.dossier .zone-meta {
    font-size: 14px;
    color: rgb(190, 176, 146);
}

.dossier .zone-text {
    font-size: 16px;
    color: rgb(222, 218, 206);
}

.dossier .zone-section-title {
    font-size: 13px;
    margin-top: 16px;
}

/* ---- Сбор отряда ---- */

.muster-squads {
    flex-direction: row;
    margin-bottom: 8px;
}

.squad-tab {
    height: 30px;
    font-size: 12px;
    margin-right: 6px;
    padding: 0 14px;
    color: rgb(212, 202, 178);
    background-color: rgb(44, 46, 40);
    border-width: 1px;
    border-color: rgb(96, 88, 70);
}

.squad-tab.selected {
    background-color: rgb(92, 78, 44);
    border-color: rgb(226, 190, 110);
    color: rgb(244, 232, 200);
}

.muster-columns {
    flex-direction: row;
    flex-grow: 1;
}

.muster-column {
    width: 45%;
    margin-right: 14px;
}

.muster-column.wide {
    width: 55%;
    margin-right: 0;
}

.muster-free {
    flex-grow: 1;
}

.guild-block {
    border-width: 1px;
    border-color: rgb(96, 88, 70);
    background-color: rgb(28, 30, 26);
    padding: 8px;
    margin-bottom: 8px;
}

.guild-title {
    color: rgb(198, 178, 138);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.guild-tiles {
    flex-direction: row;
    flex-wrap: wrap;
}

.guild-tile {
    flex-direction: row;
    width: 236px;
    height: 136px;
    border-width: 1px;
    border-color: rgb(96, 88, 70);
    background-color: rgb(44, 46, 40);
    padding: 6px;
    margin: 0 8px 8px 0;
}

.guild-tile.status-ok { border-color: rgb(92, 118, 78); }
.guild-tile.status-wounded { border-color: rgb(198, 148, 72); background-color: rgb(48, 42, 32); }
.guild-tile.status-dead { border-color: rgb(118, 68, 62); background-color: rgb(36, 32, 32); opacity: 0.55; }
.guild-tile.busy {
    opacity: 1;
    border-color: rgb(126, 104, 70);
    background-color: rgb(38, 40, 34);
}

.guild-tile.busy .person-note {
    color: rgb(214, 170, 118);
}

.guild-tile .portrait {
    width: 76px;
    height: 76px;
}

.muster-tray {
    flex-direction: row;
    min-height: 120px;
    border-width: 2px;
    border-color: rgb(110, 96, 70);
    background-color: rgb(30, 32, 28);
    padding: 8px;
    margin-bottom: 8px;
}

.muster-tray.accepting {
    border-color: rgb(240, 190, 90);
    background-color: rgb(52, 48, 34);
}

.tray-slot {
    flex-direction: row;
    flex-shrink: 0;
    width: 232px;
    height: 136px;
    border-width: 1px;
    border-color: rgb(84, 78, 64);
    margin-right: 6px;
    padding: 6px;
}

.tray-slot .portrait {
    width: 70px;
    height: 70px;
}

.tray-role {
    height: 22px;
    font-size: 10px;
    margin-top: 4px;
    padding: 0;
    color: rgb(226, 208, 170);
    background-color: rgb(56, 58, 50);
    border-width: 1px;
    border-color: rgb(96, 88, 70);
}

.tray-remove {
    width: 74px;
    height: 22px;
    font-size: 11px;
    padding: 0;
    margin-top: 4px;
    color: rgb(238, 178, 150);
    background-color: rgb(60, 40, 34);
    border-width: 1px;
    border-color: rgb(150, 90, 70);
}

.muster-orders {
    flex-direction: row;
}

.order-button {
    flex-grow: 1;
    height: 30px;
    font-size: 10px;
    margin-right: 4px;
    padding: 0 4px;
    color: rgb(206, 198, 178);
    background-color: rgb(44, 46, 40);
    border-width: 1px;
    border-color: rgb(90, 84, 70);
    white-space: normal;
}

.drag-ghost {
    position: absolute;
    padding: 4px 10px;
    background-color: rgb(70, 62, 44);
    border-width: 2px;
    border-color: rgb(240, 190, 90);
    color: rgb(245, 232, 200);
    font-size: 12px;
}

/* ---- модал приказа ---- */

.modal {
    position: absolute;
    left: 360px;
    right: 360px;
    top: 120px;
    bottom: 120px;
    background-color: rgb(18, 20, 18);
    border-width: 2px;
    border-color: rgb(196, 150, 90);
    padding: 20px;
}

.modal-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.modal-portraits {
    flex-direction: row;
    margin: 4px 0 8px 0;
}

.modal-portraits .portrait {
    width: 54px;
    height: 54px;
    margin-right: 6px;
    border-color: rgb(150, 128, 88);
    flex-shrink: 0;
}

.warning-line {
    color: rgb(228, 172, 118);
}

.modal-buttons .action {
    margin-left: 8px;
    width: 220px;
}

/* ---- палитра кита: бирюза и золото ---- */

.pane,
.evening,
.dossier,
.muster,
.village,
.startday,
.monster-modal,
.modal,
.expedition {
    background-color: rgb(17, 27, 32);
    border-color: rgb(201, 154, 90);
}

/* Встреча — единственное окно с красной рамкой: она про опасность, а не про стиль. */
.monster-modal {
    border-color: rgb(228, 96, 70);
}
